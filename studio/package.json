{
  "name": "airspace-studio",
  "type": "module",
  "version": "0.1.7",
  "description": "A visual CMS for your PDS content layer.",
  "author": "Misha <self@mkrl.xyz>",
  "license": "MIT",
  "homepage": "https://getair.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/airspace.git",
    "directory": "studio"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./cli": "./dist/cli.mjs",
      "./package.json": "./package.json"
    }
  },
  "bin": {
    "airspace-studio": "./bin/airspace-studio.mjs"
  },
  "files": [
    "app",
    "bin",
    "dist",
    "nuxt.config.ts",
    "public",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "tsdown",
    "build:app": "nuxt build",
    "preview": "nuxt preview",
    "prepare": "nuxt prepare",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@nuxt/fonts": "https://pkg.pr.new/@nuxt/fonts@35924e7",
    "airspace": "workspace:*",
    "nitro": "3.0.260903-beta",
    "nuxt": "npm:nuxt-nightly@5x",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "publint": "0.3.24",
    "tsdown": "0.23.0"
  }
}
